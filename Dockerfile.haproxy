FROM haproxy:2.8-alpine

# Switch to root for package installation (standard Alpine pattern)
USER root

# Install only Python3 interpreter (pip not needed, saves space)
RUN apk add --no-cache python3

# Create necessary directories
RUN mkdir -p /scripts /config

# Copy scripts with proper ownership
COPY --chown=haproxy:haproxy scripts/generate_haproxy_config.py /scripts/
COPY --chown=haproxy:haproxy scripts/entrypoint.haproxy.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Drop back to unprivileged user for runtime security
USER haproxy

ENTRYPOINT ["/entrypoint.sh"]