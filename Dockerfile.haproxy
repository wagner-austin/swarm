FROM haproxy:3.2-alpine

# Switch to root for package installation (standard Alpine pattern)
USER root

# Install only Python3 interpreter (pip not needed, saves space)
RUN apk add --no-cache python3

# Create necessary directories
RUN mkdir -p /scripts /config

# Copy scripts with proper ownership
COPY --chown=haproxy:haproxy scripts/generate_haproxy_config.py /scripts/
COPY --chown=haproxy:haproxy scripts/entrypoint.haproxy.sh /entrypoint.sh
# Strip CR and make executable
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Drop back to unprivileged user for runtime security
USER haproxy

# Health check - verify HAProxy is listening on 6380 using Python (nc may be unavailable)
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python3", "-c", "import socket; s=socket.socket(); s.settimeout(2); s.connect(('127.0.0.1', 6380)); s.close()"]

ENTRYPOINT ["/entrypoint.sh"]
